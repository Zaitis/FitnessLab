# Copied to `.env` at the repo root on the VPS (next to
# docker-compose.prod.yml), NOT committed. Read only by the `postgres`
# service in docker-compose.prod.yml. POSTGRES_PASSWORD must match
# backend/.env's DB_PASSWORD — see docker-compose.prod.yml and
# docs/DEPLOYMENT.md for why these are two separate files.

POSTGRES_DB=fitnesslab
POSTGRES_USER=fitnesslab
POSTGRES_PASSWORD=
