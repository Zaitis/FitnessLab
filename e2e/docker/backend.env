# Backend environment for the E2E stack only — mirrors
# backend/.env.production.example's shape (same drivers, same topology
# reasoning) adapted for Docker-local networking instead of the real
# zaitis.dev domain. Committed rather than generated per-run: nothing here
# is a real secret, and a fixed, known-good file removes one more moving
# part from "does the E2E stack actually work" (.ai/code-review.md's
# warning about unverified infra-as-code applies to env files too).

APP_NAME=FitnessLab
APP_ENV=testing
APP_KEY=base64:zrOmZ0YrOa2/Y58NSLrXanfTbAJ9MGs6ND4vYnutc84=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=daily,database
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
ERROR_LOG_RETENTION_DAYS=30

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fitnesslab
DB_USERNAME=fitnesslab
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# No leading dot, unlike production's .zaitis.dev — both hosts here are
# plain `localhost` on different ports, and cookies aren't port-scoped.
SESSION_DOMAIN=localhost
SESSION_COOKIE=fitnesslab_e2e_session
# Plain HTTP in this stack — there is no TLS to require.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

FRONTEND_URL=http://localhost:4173
SANCTUM_STATEFUL_DOMAINS=localhost:4173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=fitnesslab_e2e_cache

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=fitnesslab_e2e_

MAIL_MAILER=log
MAIL_FROM_ADDRESS=fitnesslab@example.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
