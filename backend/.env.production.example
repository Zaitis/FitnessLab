# Copied to backend/.env on the VPS, NOT committed. Read by the backend,
# queue, and scheduler services in docker-compose.prod.yml.
#
# Values below encode the production decisions from ADR-004
# (docs/adr/ADR-004-deployment-topology.md) — read that before changing
# SESSION_DOMAIN, SESSION_COOKIE, or SANCTUM_STATEFUL_DOMAINS. In short:
# the SPA and API are on different subdomains of zaitis.dev, so the
# session cookie has to be scoped to the parent domain, which means every
# other project under zaitis.dev also receives it — that's a reviewed,
# accepted risk, not an oversight, and the settings below are the
# mitigations for it. Don't widen SANCTUM_STATEFUL_DOMAINS or the CORS
# allow-list to a wildcard over *.zaitis.dev.

APP_NAME=FitnessLab
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://fitnesslab-api.zaitis.dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,database
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
ERROR_LOG_RETENTION_DAYS=30

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fitnesslab
DB_USERNAME=fitnesslab
# Must equal POSTGRES_PASSWORD in the repo-root .env — see
# docker-compose.prod.yml.
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leading dot: shared across every *.zaitis.dev subdomain. Required for
# the SPA (fitnesslab.zaitis.dev) and API (fitnesslab-api.zaitis.dev) to
# see the same session cookie — see ADR-004.
SESSION_DOMAIN=.zaitis.dev
# Named distinctly so it can't collide with another project's cookie
# under the shared domain.
SESSION_COOKIE=fitnesslab_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FRONTEND_URL=https://fitnesslab.zaitis.dev
# Exact host:port match only — never a wildcard over *.zaitis.dev.
SANCTUM_STATEFUL_DOMAINS=fitnesslab.zaitis.dev

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=fitnesslab_cache

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=fitnesslab_

MAIL_MAILER=smtp
MAIL_HOST=smtp.zoho.eu
MAIL_PORT=587
MAIL_USERNAME=fitnesslab@zaitis.dev
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=fitnesslab@zaitis.dev
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
